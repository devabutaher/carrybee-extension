{
  "manifest_version": 3,
  "name": "CarryBee Check Entry",
  "description": "Check if a parcel exists for a given business on CarryBee Order Processing.",
  "version": "1.3.0",
  "minimum_chrome_version": "116",
  "permissions": [
    "activeTab",
    "tabs",
    "scripting",
    "clipboardRead",
    "offscreen"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup/index.html",
    "default_icon": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" }
  },
  "commands": {
    "focus-entry": {
      "suggested_key": { "default": "Alt+Q" },
      "description": "Open/raise the Check Entry window and fill the Business Name field from the clipboard"
    }
  },
  "content_scripts": [
    {
      "matches": ["*://hive.carrybee.com/order-processing*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" }
}
