  "description": "Automates the Order Processing flow on CarryBee. Supports Merchant Order ID, Customer Phone, COD Quantity, and Consignment ID modes.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt dev",
    "build": "wxt build && node scripts/copy-content-css.mjs",
